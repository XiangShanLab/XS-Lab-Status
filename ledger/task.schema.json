{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "TaskIssueMetadata",
  "type": "object",
  "required": ["type", "complexity", "priority", "ddl", "estimate_hours", "milestone", "deliverables"],
  "properties": {
    "type": {"const": "task"},
    "complexity": {"type": "integer", "minimum": 1, "maximum": 5},
    "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
    "ddl": {"type": "string", "format": "date"},
    "estimate_hours": {"type": "number", "minimum": 0},
    "milestone": {"type": "string", "minLength": 1},
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": true
}
