{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review.schema.json",
  "title": "ReviewIssueMetadata",
  "type": "object",
  "required": ["type", "issue", "score", "conclusion", "checklist"],
  "properties": {
    "type": {"const": "review"},
    "issue": {"type": "string", "minLength": 1},
    "score": {"type": "number", "minimum": 1, "maximum": 5},
    "conclusion": {"enum": ["pass", "fail", "conditional"]},
    "rejection_reason": {"type": "string"},
    "checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item", "passed"],
        "properties": {
          "item": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "note": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
